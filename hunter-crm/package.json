{
  "name": "hunter-crm",
  "version": "1.0.0",
  "description": "Hunter CRM - a sales prospecting CRM with a Postgres + Express backend and static HTML/CSS/JS frontend",
  "main": "backend/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "db:init": "node backend/db/init.js",
    "db:seed": "node backend/db/seed.js",
    "test": "node test/api.test.mjs",
    "test:ui": "node test/ui.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18"
  }
}
