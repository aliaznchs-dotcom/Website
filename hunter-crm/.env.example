# Postgres connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=huntercrm
PGUSER=postgres
PGPASSWORD=postgres

# Or a single connection string (takes precedence if set)
# DATABASE_URL=postgres://user:password@localhost:5432/huntercrm

# App
PORT=3100
JWT_SECRET=change-this-to-a-long-random-secret

# Hosted deployments only — see DEPLOY.md.
# AUTO_MIGRATE applies the schema on boot; SEED_DEMO loads the demo account if
# it is absent. Both are safe to repeat, and both are off unless set to "true".
# AUTO_MIGRATE=true
# SEED_DEMO=true

# Database TLS: unset (inferred), true, no-verify, or false.
# DATABASE_SSL=true
